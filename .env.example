# Supabase PostgreSQL 接続URL
# Supabase Dashboard > Settings > Database > Connection string から取得
#
# Transaction mode (pooling) - API Routes で使用
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
#
# Direct connection - マイグレーション実行時に使用
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# LMS のベースURL（デフォルトは関西大学LMS）
LMS_BASE_URL="https://lms.kansai-u.ac.jp"
